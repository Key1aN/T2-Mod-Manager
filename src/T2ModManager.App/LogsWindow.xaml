<Window x:Class="T2ModManager.App.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T2 Mod Manager - Logs" Width="1100" Height="700"
        MinWidth="820" MinHeight="480" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Logs" FontSize="24" FontWeight="Bold"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           Text="Manager activity plus the game's trace, crash, and fatal-error files. Use Create Report to bundle everything (including crash dumps) into one ZIP you can send."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Click="RefreshButton_Click" Background="#2B3343" Margin="0,0,8,0"/>
                <Button Content="Open Folder" Click="OpenFolderButton_Click" Background="#2B3343" Margin="0,0,8,0"/>
                <Button Content="Copy Text" Click="CopyButton_Click" Background="#2B3343" Margin="0,0,8,0"/>
                <Button x:Name="ReportButton" Content="Create Report" Click="ReportButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,12,0">
                <ListBox x:Name="FilesList" SelectionMode="Single" SelectionChanged="FilesList_SelectionChanged"
                         Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1" Padding="4" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B2130"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B3343"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details}" Foreground="{Binding DetailBrush}"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoFilesText" Text="No log files yet." Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Border Grid.Column="1" Background="#10141C" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBox x:Name="ContentText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" Padding="12" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Text="Select a log file to view it."/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#10141C" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
