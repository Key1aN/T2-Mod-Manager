<Window x:Class="T2ModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T2 Mod Manager" Width="1040" Height="680"
        MinWidth="900" MinHeight="600" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="T2 Mod Manager" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Version 0.2.3 · Portable · TMNT 2: Battle Nexus · US/NA PC" Foreground="{StaticResource MutedBrush}"
                           FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LogsButton" Content="Logs" Click="LogsButton_Click"
                        Background="#2B3343" Margin="0,0,10,0"
                        ToolTip="View manager and game crash logs, or create a report to share"/>
                <Button x:Name="LaunchButton" Content="Launch Game"
                        Click="LaunchButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20"
                Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Game installation" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GamePathText" Text="No game folder selected"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Select Folder" Click="SelectFolderButton_Click"
                        Margin="18,0,8,0" Background="#2B3343"/>
                <Button Grid.Column="2" x:Name="VerifyButton" Content="Verify &amp; Back Up"
                        Click="VerifyButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Mods" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Check any compatible mods to use them together. Select a mod to view its package description."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="7*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,10,0">
                            <ListBox x:Name="ModsList" SelectionMode="Single"
                                     SelectionChanged="ModsList_SelectionChanged"
                                     Background="#10141C" BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1" Padding="4"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1B2130"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2B3343"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Active, Mode=OneWay}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      Click="ModActiveCheckBox_Click"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      ToolTip="Activate or deactivate this mod"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VersionLabel}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoModsText" Text="No mod packages added."
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <Border Grid.Column="1" Background="#10141C" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="16" Margin="10,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Description" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedModNameText" Text="No mod selected"
                                               FontSize="18" FontWeight="Bold" Margin="0,14,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedModVersionText"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedModDescriptionText"
                                               Text="Select a mod from the list to view the description stored in its .t2mod package."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               LineHeight="20" Margin="0,14,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="2" Margin="0,18" Background="{StaticResource BorderBrush}"/>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Safe installation" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,5,0,0"
                                       Text="Every combination is rebuilt and verified from the vanilla backup before live files are replaced."/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="InstallPackageButton"
                                Content="Add .t2mod Package" Click="InstallPackageButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"
                    Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Recovery" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Return the managed installation to its verified retail state."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               LineHeight="21" Margin="0,10,0,18"/>
                    <Button x:Name="RestoreButton" Content="Restore Vanilla"
                            Click="RestoreButton_Click" Background="#2B3343" IsEnabled="False"/>
                    <Separator Margin="0,24" Background="{StaticResource BorderBrush}"/>
                    <TextBlock Text="Protection" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Compatible mods share a verified T2 Core. Unknown hashes, real resource conflicts, invalid LPAC files, and interrupted transactions are blocked automatically."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               LineHeight="21" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#10141C" CornerRadius="8" Padding="14,10" Margin="0,22,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}"/>
                <ProgressBar Grid.Column="1" x:Name="Progress" Height="6" Minimum="0" Maximum="1"
                             Value="0" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
