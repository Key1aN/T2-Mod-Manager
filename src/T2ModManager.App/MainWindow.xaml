<Window x:Class="T2ModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T2 Mod Manager" Width="1080" Height="760"
        MinWidth="980" MinHeight="720" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="T2 Mod Manager" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Version 0.1 · TMNT 2: Battle Nexus · US/NA PC" Foreground="{StaticResource MutedBrush}"
                           FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="LaunchButton" Content="Launch Game"
                    Click="LaunchButton_Click" VerticalAlignment="Center" IsEnabled="False"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20"
                Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Game installation" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GamePathText" Text="No game folder selected"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Select Folder" Click="SelectFolderButton_Click"
                        Margin="18,0,8,0" Background="#2B3343"/>
                <Button Grid.Column="2" x:Name="VerifyButton" Content="Verify &amp; Back Up"
                        Click="VerifyButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"
                    Margin="0,0,12,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ultimate Slashuur" FontSize="21" FontWeight="Bold"/>
                            <TextBlock Text="Package ID: Ultimate_Slashuur" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="ModStatusBadge" Background="#343B4A"
                                CornerRadius="12" Padding="12,5" VerticalAlignment="Top">
                            <TextBlock x:Name="ModStatusText" Text="Not installed" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="22"
                               Text="Playable Slashuur with five boss moves and Adaptive Teleport v2. This standalone mod does not enable MSAA, Intro Skip, widescreen, or difficulty modifications."/>
                    <Separator Margin="0,20" Background="{StaticResource BorderBrush}"/>
                    <TextBlock Text="Safe installation" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"
                               Text="Every activation is rebuilt from the verified vanilla backup. TMNT2.exe, TMNT.DAT, and LPAC output hashes are checked before the live files are replaced."/>
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="InstallPackageButton" Content="Add .t2mod Package"
                                Click="InstallPackageButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="ToggleModButton" Content="Activate" Click="ToggleModButton_Click"
                                Background="#2B3343" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"
                    Margin="12,0,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fix Obsolete Disc Check" FontSize="18" FontWeight="Bold"/>
                        <Border Grid.Column="1" x:Name="DiscFixStatusBadge" Background="#343B4A"
                                CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                            <TextBlock x:Name="DiscFixStatusText" Text="Not imported" FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Optional fixed-vanilla EXE baseline for modern Windows. It stays active when gameplay mods are disabled; the untouched retail backup is never changed."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               LineHeight="20" Margin="0,10,0,14"/>
                    <Button x:Name="DiscFixButton" Content="Import Fix EXE"
                            Click="DiscFixButton_Click" Background="#2B3343" IsEnabled="False"/>
                    <Separator Margin="0,24" Background="{StaticResource BorderBrush}"/>
                    <TextBlock Text="Recovery" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Deactivate all mods and the compatibility fix, then restore the verified retail EXE and DAT."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               LineHeight="21" Margin="0,10,0,18"/>
                    <Button x:Name="RestoreButton" Content="Restore Retail Original"
                            Click="RestoreButton_Click" Background="#2B3343" IsEnabled="False"/>
                    <Separator Margin="0,24" Background="{StaticResource BorderBrush}"/>
                    <TextBlock Text="Protection" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Unknown EXE/DAT hashes, conflicting resources, invalid LPAC files, and interrupted transactions are blocked automatically."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               LineHeight="21" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#10141C" CornerRadius="8" Padding="14,10" Margin="0,22,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}"/>
                <ProgressBar Grid.Column="1" x:Name="Progress" Height="6" Minimum="0" Maximum="1"
                             Value="0" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
